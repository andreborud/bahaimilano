<article class="post-card">
    {{#if feature_image}}<a class="card-image" href="{{url}}" tabindex="-1" aria-hidden="true"><img src="{{img_url feature_image size="card"}}" alt="" loading="lazy"></a>{{/if}}
    <div class="card-body"><p class="eyebrow">{{#primary_tag}}{{name}}{{else}}ARTICOLO{{/primary_tag}}</p><h2><a href="{{url}}">{{title}}</a></h2>{{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}<a class="text-link" href="{{url}}">Leggi →</a></div>
</article>
